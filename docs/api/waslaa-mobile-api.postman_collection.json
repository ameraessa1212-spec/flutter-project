{
  "info": {
    "name": "Waslaa Mobile API",
    "description": "Complete API collection for Waslaa Mobile App (v1).\n\nBase URL: {{base_url}}/api/mobile/v1\n\n## Setup\n1. Import this collection into Postman\n2. Create an environment with variable `base_url` = `http://localhost:8000`\n3. Register → verify OTP (use code `6666`) → login to get a token\n4. The `Login` request auto-saves the token to `{{token}}` via a test script\n5. All authenticated requests use `{{token}}` automatically\n\n## OTP Note\nDuring development the OTP is always **6666**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "waslaa-mobile-api-v1"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ahmed\",\n  \"last_name\": \"Al-Rashidi\",\n  \"username\": \"ahmed_rashidi\",\n  \"email\": \"ahmed@example.com\",\n  \"phone\": \"0501234567\",\n  \"password\": \"Secret123!\",\n  \"password_confirmation\": \"Secret123!\",\n  \"student_number\": \"2021001234\",\n  \"specialization_id\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "v1", "auth", "register"]
            },
            "description": "Register a new student account. Status will be `pending` until OTP is verified."
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"ahmed@example.com\",\n  \"otp\": \"6666\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/v1/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "v1", "auth", "verify-otp"]
            },
            "description": "Verify OTP to activate the account. Development OTP: 6666"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.environment.set('token', json.data.token);",
                  "  console.log('Token saved:', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"ahmed@example.com\",\n  \"password\": \"Secret123!\",\n  \"device_name\": \"Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "v1", "auth", "login"]
            },
            "description": "Login with email/username/phone. The token is auto-saved to {{token}} variable via test script."
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "v1", "auth", "me"]
            },
            "description": "Get the currently authenticated user."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "v1", "auth", "logout"]
            },
            "description": "Revoke the current device token."
          },
          "response": []
        },
        {
          "name": "Logout All Devices",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/v1/auth/logout-all",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "v1", "auth", "logout-all"]
            },
            "description": "Revoke all tokens for the authenticated user."
          },
          "response": []
        }
      ]
    },
